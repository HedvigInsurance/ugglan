      "kind": "group",
      "name": "Project",
      "children": [
        {
          "kind": "group",
          "path": "../../Configurations",
          "children": [
            {
              "kind": "group",
              "path": "Base",
              "children": [
                {
                  "kind": "group",
                  "path": "Configurations",
                  "children": [
                    { "path": "Debug.xcconfig" },
                    { "path": "Release.xcconfig" },
                  ],
                },
              ],
            }, {
              "kind": "group",
              "path": "iOS",
              "children": [
                { "path": "iOS-Application.xcconfig" },
                { "path": "iOS-Base.xcconfig" },
                { "path": "iOS-Framework-Debug.xcconfig" },
                { "path": "iOS-Framework-Release.xcconfig" },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "Derived",
          "children": [
            {
              "kind": "group",
              "path": "InfoPlists",
              "children": [
                { "path": "PaymentExample-Info.plist" },
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "Example",
          "children": [
            {
              "kind": "group",
              "path": "Resources",
              "children": [
                { "path": "Assets.xcassets", "target-membership": [ "PaymentExample/resources" ] },
              ],
            }, {
              "kind": "group",
              "path": "Sources",
              "children": [
                { "path": "AppDelegate.swift", "target-membership": [ "PaymentExample/compile-sources" ] },
              ],
            },
          ],
        },
        { "kind": "folder", "path": "Sources", "target-membership": [ "Payment" ] },
        { "kind": "folder", "path": "Tests", "target-membership": [ "PaymentTests" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Payment",
      "id": "D329983150604C64038D7FD8",
      "product": "Products/Payment.framework",
      "product-type": "framework",
      "specialized-configurations": [
        { "name": "Debug", "file": "Project/Configurations/iOS/iOS-Framework-Debug.xcconfig" },
        { "name": "Release", "file": "Project/Configurations/iOS/iOS-Framework-Release.xcconfig" },
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "CODE_SIGN_IDENTITY": "",
        "CURRENT_PROJECT_VERSION": "1",
        "DEFINES_MODULE": "YES",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "EXCLUDED_SOURCE_FILE_NAMES": [
          "$(inherited)",
          ".gitkeep",
          ".DS_Store",
        ],
        "GENERATE_INFOPLIST_FILE": "YES",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.hedvig.Payment",
        "PRODUCT_NAME": "Payment",
        "SDKROOT": "iphoneos",
        "SKIP_INSTALL": "YES",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": [
          "$(inherited)",
          "DEBUG",
        ],
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.3",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "VERSIONING_SYSTEM": "apple-generic",
        "VERSION_INFO_PREFIX": "",
      },
    }, {
      "name": "PaymentExample",
      "id": "FE86901B9187623AD4C06005",
      "product": "Products/PaymentExample.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Project/Configurations/iOS/iOS-Application.xcconfig" },
        { "name": "Release", "file": "Project/Configurations/iOS/iOS-Application.xcconfig" },
      ],
      "dependencies": [
        "Payment",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Clean frameworks",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"$SRCROOT\"/../../scripts/post-build-action.sh ",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "CODE_SIGN_STYLE": "automatic",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "Derived/InfoPlists/PaymentExample-Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.hedvig.example.PaymentExample",
        "PRODUCT_NAME": "PaymentExample",
        "PROVISIONING_PROFILE_SPECIFIER": "match Development com.hedvig.example.*",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": [
          "$(inherited)",
          "DEBUG",
        ],
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.3",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "PaymentTests",
      "id": "963F8AF78FF4A53AC7A856E5",
      "product": "Products/PaymentTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "PaymentExample",
      "specialized-configurations": [
        { "name": "Debug", "file": "Project/Configurations/iOS/iOS-Base.xcconfig" },
        { "name": "Release", "file": "Project/Configurations/iOS/iOS-Base.xcconfig" },
      ],
      "dependencies": [
        "Payment",
        "PaymentExample",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "EXCLUDED_SOURCE_FILE_NAMES": [
          "$(inherited)",
          ".gitkeep",
          ".DS_Store",
        ],
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_LDFLAGS": [
          "$(inherited)",
          "-L$(DT_TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.hedvig.PaymentTests",
        "PRODUCT_NAME": "PaymentTests",
        "SDKROOT": "iphoneos",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": [
          "$(inherited)",
          "DEBUG",
        ],
        "SWIFT_COMPILATION_MODE[config=Debug]": "singlefile",
        "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
        "SWIFT_VERSION": "6.3",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/PaymentExample.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/PaymentExample",
        "TEST_TARGET_NAME": "PaymentExample",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SWIFT_VERSION": "6.3",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "2600.0",
}
